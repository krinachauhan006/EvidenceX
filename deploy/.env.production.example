# EvidenceX production settings. Copy to deploy/.env.production on the server and fill in.
# NEVER commit the filled-in file. All values here are placeholders.

# Public domain served by Caddy (DNS must point at the server; ports 80/443 open).
EVIDENCEX_DOMAIN=evidencex.example.org

# Must equal the public origin exactly (scheme + host, no trailing slash).
CORS_ORIGINS=https://evidencex.example.org
COOKIE_SECURE=true
APP_ENV=production

# Accounts: set REGISTRATION_OPEN=false once the team's accounts exist.
REGISTRATION_OPEN=true
SESSION_DAYS=7
LOGIN_MAX_FAILURES=8
LOGIN_LOCKOUT_MINUTES=15

# Cases created before sign-in existed go ONLY to this account (empty = nobody).
LEGACY_CASES_OWNER_EMAIL=

# Database. Default: SQLite on the persistent /data volume (the tested configuration).
# DATABASE_URL=sqlite+pysqlite:////data/evidencex.db

# Optional AI (off by default; also needs per-case owner consent in the app).
CLAIM_EXTRACTOR=rule_based
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Limits
MAX_UPLOAD_SIZE_MB=25
MAX_VIDEO_UPLOAD_MB=200
