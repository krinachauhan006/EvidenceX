# EvidenceX backend on Vercel (project root: backend/). PLACEHOLDERS ONLY.
# Enter real values in Vercel > Project > Settings > Environment Variables.
# Never commit real values. See docs/VERCEL_DEPLOYMENT.md.

# --- required -----------------------------------------------------------------
APP_ENV=production
COOKIE_SECURE=true
# Managed PostgreSQL. postgres:// or postgresql:// URLs are accepted (psycopg is used).
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require
STORAGE_BACKEND=s3
S3_BUCKET=<bucket-name>
S3_ACCESS_KEY_ID=<access-key-id>
S3_SECRET_ACCESS_KEY=<secret-access-key>
# Supabase Storage: https://<project-ref>.storage.supabase.co/storage/v1/s3
# Leave empty for AWS S3.
S3_ENDPOINT_URL=<s3-endpoint-url>
S3_REGION=<region>
# The frontend's public origin(s), comma-separated, no trailing slash. Writes from any
# other origin are refused (CSRF check).
CORS_ORIGINS=https://<frontend-project>.vercel.app
# Serverless: extraction runs inside the request's function (no worker subprocess).
PROCESSING_ISOLATION=inline

# --- recommended --------------------------------------------------------------
# Vercel accepts request bodies up to 4.5 MB; set the app's limits below it so the
# limit is explained instead of failing at the platform.
MAX_UPLOAD_SIZE_MB=4
MAX_VIDEO_UPLOAD_MB=4
# Items interrupted by the 300 s function limit become retryable after this.
PROCESSING_STALE_MINUTES=10
ANALYSIS_STALE_MINUTES=10
# Rule-based analysis only (no AI) unless you deliberately configure Gemini.
CLAIM_EXTRACTOR=rule_based
# Set to false after the demo and team accounts are registered.
REGISTRATION_OPEN=true

# --- transaction pooler -------------------------------------------------------------
# REQUIRED when DATABASE_URL uses the Supabase Transaction Pooler (port 6543), which is
# the recommended runtime URL on Vercel. The transaction pooler does not support
# prepared statements; this setting disables them and per-process connection pooling.
# Only set it to false if DATABASE_URL points at a session pooler or direct connection.
DATABASE_TRANSACTION_POOLER=true

# --- optional ---------------------------------------------------------------------
# DATABASE_POOL_SIZE=2
# DATABASE_MAX_OVERFLOW=3
# GEMINI_API_KEY=<only if AI is enabled; needs per-case consent>
# VERCEL is set by the platform automatically; do not set it yourself.
