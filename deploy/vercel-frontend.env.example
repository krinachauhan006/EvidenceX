# EvidenceX frontend on Vercel (project root: frontend/). PLACEHOLDERS ONLY.
# Enter real values in Vercel > Project > Settings > Environment Variables.

# Required: the backend project's origin (no path, no trailing slash). Server-side only;
# Next.js forwards /api/* and /health there, so the browser stays on one origin.
EVIDENCEX_API_ORIGIN=https://<backend-project>.vercel.app

# Do NOT set NEXT_PUBLIC_API_BASE_URL on Vercel. Unset, the browser uses relative URLs
# (same origin), which the proxy above requires for the session cookie.
