# Frontend configuration. Copy to .env.local for local dev. Placeholders only.

# Local development: the browser calls the API directly on port 8000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Deployment with a separate backend (e.g. two Vercel projects): leave
# NEXT_PUBLIC_API_BASE_URL UNSET and set the backend origin here instead. It is read on
# the server only; Next.js then forwards /api/* and /health to it, so the browser
# stays on one origin and the session cookie stays first-party.
# EVIDENCEX_API_ORIGIN=https://<your-backend-project>.vercel.app
