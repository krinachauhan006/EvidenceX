# EvidenceX backend configuration. Copy to .env and fill in. NEVER commit .env.

# Application
APP_ENV=development

# Database (Postgres). docker-compose provides this value for local dev.
DATABASE_URL=postgresql+psycopg://evidencex:evidencex@localhost:5432/evidencex

# Local evidence storage root (content-addressed). Keep OUTSIDE any web-served dir.
STORAGE_ROOT=./var/storage

# Maximum accepted upload size, in megabytes.
MAX_UPLOAD_SIZE_MB=25

# --- Stage 3: evidence processing ------------------------------------------------
# How many heavy extractions may run at once (OCR/audio are memory hungry).
PROCESSING_MAX_CONCURRENCY=1
# An item stuck in "processing" longer than this is treated as abandoned.
PROCESSING_STALE_MINUTES=30
# Extraction safety limits.
MAX_PDF_PAGES=500
MAX_TABULAR_ROWS=50000
MAX_CELL_CHARS=32768
MAX_EXTRACTED_CHARS=5000000
MAX_IMAGE_PIXELS=50000000
# XLSX (ZIP package) limits, checked at upload and again before parsing.
MAX_ZIP_ENTRIES=2000
MAX_ZIP_UNCOMPRESSED_MB=100
MAX_ZIP_ENTRY_MB=50
MAX_SHARED_STRINGS_MB=20
MAX_ZIP_COMPRESSION_RATIO=100

# Tesseract OCR (images and scanned PDF pages). Empty = look on PATH, then in the
# default Windows folder. Set the full path if tesseract.exe is installed elsewhere:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_LANGS=eng
# OCR text below this mean engine confidence is kept but the result is marked Partial.
OCR_MIN_CONFIDENCE=0.40
OCR_TIMEOUT_SECONDS=120
# Render and OCR PDF pages that have no text layer (needs Tesseract).
PDF_OCR_FALLBACK=true
# PyMuPDF (PDF reader) is AGPL-3.0 or commercial. Set to false to leave PDF off.
PDF_EXTRACTION_ENABLED=true

# Speech transcription (faster-whisper). The model is NEVER downloaded automatically.
# Download it once, on purpose:  python -m app.tools.fetch_whisper_model --size base
WHISPER_MODEL_SIZE=base
WHISPER_MODEL_DIR=./var/models
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Empty = detect the language automatically.
WHISPER_LANGUAGE=
WHISPER_ALLOW_DOWNLOAD=false
WHISPER_VAD_FILTER=true
# Word-level alignment: keeps segment times inside the recording and records the engine's
# per-word probability. It does not change the transcript text.
WHISPER_WORD_TIMESTAMPS=true
# Words the engine rates below this probability are flagged as possibly misheard.
WHISPER_LOW_WORD_PROBABILITY=0.5
# Optional recognition prompt. Leave empty: in testing it fixed some words but changed the
# meaning of others. Any use is recorded as a warning on the extraction.
WHISPER_INITIAL_PROMPT=
# A relative WHISPER_MODEL_DIR is resolved from the backend folder, not from the
# directory the server was started in.
# Longest recording transcribed, in seconds (checked while decoding, before the model
# loads). 1200 s = 20 minutes, about 77 MB of decoded samples.
MAX_AUDIO_SECONDS=1200
# Wall-clock limit per audio item, in seconds (decode + model load + transcription).
# Checked between ~30 s transcript windows, so it can overrun by one window.
AUDIO_TIMEOUT_SECONDS=1800

# CORS: comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# --- Phase 1: analysis -----------------------------------------------------------
# Claim extractor: "rule_based" (default; deterministic, offline, not AI) or "gemini".
# Gemini is used only when CLAIM_EXTRACTOR=gemini AND GEMINI_API_KEY is set; it needs
# network access. Its output is schema-validated, quotes are re-checked against the
# source segment, and one repair attempt is made before the item fails.
CLAIM_EXTRACTOR=rule_based
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=60
# A case analysis still "running" after this long no longer blocks a new one.
ANALYSIS_STALE_MINUTES=30

# AI — secrets ONLY via environment, never committed.
GEMINI_API_KEY=
